# Copy to .env and fill in your own values. .env is gitignored — never commit it.

# 智谱 AI API Key（OCR 拍照识词），申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key

# 发布部署目标（scripts/release.sh / release-website.sh / release-webapp.sh 使用，可选）
DEPLOY_SERVER=user@your.server.ip
DEPLOY_REMOTE_DIR=/var/www/alice

# Cloudflare R2 — APK + App 截图托管（scripts/release.sh、upload-screenshots.sh）
# 一次性开通（免费额度：10 GB 存储 / 每月 1000 万次下载，流量永久免费）：
#   1. Cloudflare Dashboard → R2 → Create bucket（如 alice-apk），需先绑定支付方式
#      （不超免费额度不会扣费）
#   2. bucket → Settings → Public Development Access：开启 r2.dev 域名（快速测试），
#      或 Connect Domain 绑定自定义域名（推荐正式分发，走 Cloudflare CDN 缓存）
#   3. Dashboard 右上角 My Profile → API Tokens → Create Token → Custom token：
#      权限选 Account → R2 → Edit，账户范围选自己的账户
#   4. Account ID 在 R2 概览页右侧栏（Account details → Account ID）
# 截图上传：pnpm screenshots:upload（源文件在 docs/screenshots/，官网读 R2 URL）
R2_BUCKET=alice-apk
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-r2-api-token
